# Password for the review queue at /admin.
# If this is unset, the server generates one on first run, prints it once, and
# stores it in data/.admin-password.
ADMIN_PASSWORD=

# Signs the moderator session cookie. Keep it stable so restarts do not sign
# the moderator out. Generated into data/.session-secret when unset.
SESSION_SECRET=

# Port to listen on.
PORT=3000

# Where the SQLite file lives.
DATABASE_PATH=./data/narrativemap.db

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy, so rate limiting sees the
# real client address rather than the proxy's.
TRUST_PROXY=false

# Earliest year a narrative may be dated to.
MIN_YEAR=1800

# Abuse limits. Submissions per IP per hour, and sign-in attempts per IP per
# 15 minutes.
SUBMIT_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15_MIN=10
