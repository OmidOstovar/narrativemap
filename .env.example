# Password for the review queue at /admin.
# If this is unset, the server generates one on first run, prints it once, and
# stores it in data/.admin-password.
ADMIN_PASSWORD=

# Signs the moderator session cookie. Keep it stable so restarts do not sign
# the moderator out. Generated into data/.session-secret when unset.
SESSION_SECRET=

# Port to listen on.
PORT=3000

# Where the SQLite file lives.
DATABASE_PATH=./data/narrativemap.db

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy, so rate limiting sees the
# real client address rather than the proxy's.
TRUST_PROXY=false

# Earliest year a narrative may be dated to.
MIN_YEAR=1800

# Abuse limits. Submissions per IP per hour, and sign-in attempts per IP per
# 15 minutes.
SUBMIT_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15_MIN=10

# ---------------------------------------------------------------------------
# Telegram bot (npm run bot). Only needed if you run the bot.
# ---------------------------------------------------------------------------

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Where the bot posts narratives — the public address of the website.
NARRATIVEMAP_API=http://localhost:3000

# A shared secret, set to the SAME value on both the website and the bot. It
# lets the bot submit on behalf of many contributors without being held to the
# per-address limit meant for one visitor. Without it the bot still works, but
# a busy day will hit that limit.
BOT_API_TOKEN=

# How long an unfinished Telegram conversation is kept before it expires.
BOT_SESSION_TTL_MIN=120

# ---------------------------------------------------------------------------
# Translation
# ---------------------------------------------------------------------------

# An Anthropic API key from console.anthropic.com. Narratives are stored in the
# language they were written in and translated into the other one, so that a
# Persian testimony is readable by someone who does not read Persian.
#
# Without a key the site works exactly as before: nothing is translated,
# narratives show in their original language with a note saying so, and the
# moderator can type translations by hand.
ANTHROPIC_API_KEY=

# Optional override. The default is Claude Opus 5.
TRANSLATION_MODEL=claude-opus-5
